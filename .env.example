# Copy to .env and fill in. .env is gitignored; this file is not.
# Anything prefixed NEXT_PUBLIC_ is inlined into the client bundle at BUILD time
# and is readable by anyone. Never put a secret behind that prefix.

# ── Site ──────────────────────────────────────────────────────────────────────
# Canonical origin, no trailing slash. Drives canonical URLs, Open Graph, the
# sitemap, robots.txt AND the licence-verification endpoint the MT5 EAs call
# (see src/lib/site-config.ts). A wrong value here silently breaks licensing,
# so set it explicitly rather than relying on the hardcoded fallback.
NEXT_PUBLIC_SITE_URL=https://www.quantrabot.com

# ── Firebase (client SDK — safe to expose) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server only) ──────────────────────────────────────────────
# Path to the service-account JSON. Keep the file outside git.
FIREBASE_SERVICE_ACCOUNT_PATH=

# ── Cloudflare R2 (server only, except the public URL) ────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
# Must be set at build time or next.config.ts emits no remotePatterns and every
# R2-hosted image fails at runtime.
NEXT_PUBLIC_R2_PUBLIC_URL=

# ── Admin access ──────────────────────────────────────────────────────────────
# ADMIN_EMAILS is the server-side allowlist and is what actually enforces access.
# NEXT_PUBLIC_ADMIN_EMAILS only hides UI; it ships to the client, so treat the
# addresses in it as public.
ADMIN_EMAILS=
NEXT_PUBLIC_ADMIN_EMAILS=

# ── Social channels ───────────────────────────────────────────────────────────
# Each unset URL renders as "Not open yet" on /community and as inert text in the
# footer, rather than as a dead link. Leaving one blank is a valid state.
NEXT_PUBLIC_TELEGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# ── Integrations ──────────────────────────────────────────────────────────────
SEALION_API_KEY=

# ── Seed scripts (optional) ───────────────────────────────────────────────────
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ── Local review only ─────────────────────────────────────────────────────────
# Fills the dashboard with sample data AND bypasses the login gate. Ignored in
# production builds by construction (src/lib/demo-data.ts checks NODE_ENV), so
# setting it cannot leak an open dashboard — but leave it unset unless you are
# actively reviewing the dashboard UI locally.
NEXT_PUBLIC_DASHBOARD_DEMO=false
